# Server
PORT=8080
FRONTEND_HOST=http://localhost:3000

# PostgreSQL (docker-compose)
DATABASE_URL=postgres://moveit:moveit@localhost:5432/moveit?sslmode=disable

# S3 (adobe/s3mock)
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=moveit
S3_REGION=us-east-1

# SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@moveit.local

# TMDB
TMDB_API_KEY=

# Secrets
SESSION_SECRET=change-me
EMAIL_VERIFICATION_JWT_SECRET=change-me
RESET_PASSWORD_JWT_SECRET=change-me
